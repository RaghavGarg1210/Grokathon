# Copy this file to .env and fill in the values. Never commit .env.
# Check everything with: python -m scripts.smoke_test

# ---------------------------------------------------------------------------
# Which provider runs each step. Defaults need only Tavily, Gemini and Magic Hour.
# ---------------------------------------------------------------------------
# Finding and checking announcements: tavily (Tavily search + CRIER_LLM_PROVIDER) or xai (Grok X search)
CRIER_SEARCH_PROVIDER=tavily
# Analysis and bilingual scripts: gemini or xai
CRIER_LLM_PROVIDER=gemini
# Scene images: gemini or xai
CRIER_IMAGE_PROVIDER=gemini
# Voiceover: gemini or xai
CRIER_TTS_PROVIDER=gemini
# Hero video clips: magic_hour or xai
CRIER_VIDEO_PROVIDER=magic_hour

# ---------------------------------------------------------------------------
# Tavily (https://app.tavily.com): searches official X accounts and city websites.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
# advanced = best snippets (2 credits per search); basic = 1 credit.
TAVILY_SEARCH_DEPTH=advanced
# Results per search (1-20). Each city scan runs up to 2 searches.
TAVILY_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/apikey): analysis, scripts, images, voice.
# Free-tier keys allow ~5 requests/minute per model; calls wait out short quota windows
# automatically. Image models may need a billed project.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voices, e.g. Kore, Puck, Charon, Aoede, Sulafat.
GEMINI_TTS_VOICE_EN=Kore
GEMINI_TTS_VOICE_ES=Kore
GEMINI_TTS_LANGUAGE_EN=en-US
GEMINI_TTS_LANGUAGE_ES=es-US

# ---------------------------------------------------------------------------
# Magic Hour (https://magichour.ai/developer): animates scene stills into hero clips.
# ---------------------------------------------------------------------------
MAGIC_HOUR_API_KEY=
# ltx-2.5 is fast, cheap and allowed on free tiers; kling-3.0 / seedance-2.0 look richer.
MAGIC_HOUR_VIDEO_MODEL=ltx-2.5

# ---------------------------------------------------------------------------
# Optional: xAI / Grok. Only needed if a step above is set to xai.
# ---------------------------------------------------------------------------
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_TTS_VOICE_EN=eve
XAI_TTS_VOICE_ES=eve
XAI_TTS_LANGUAGE_ES=es-MX
# Caps Grok X Search rounds per city scan (cost control).
CRIER_X_SEARCH_MAX_TURNS=2

# ---------------------------------------------------------------------------
# App behaviour.
# ---------------------------------------------------------------------------
# 1 = read pre-seeded results and replay pipeline progress (safe for live demos).
CRIER_DEMO_MODE=0
CRIER_DATA_DIR=data
CRIER_SOURCES_PATH=config/sources.yaml
# How many days back each scan looks.
CRIER_SCAN_DAYS=30
# Briefings below this small-business relevance score (0-100) are hidden from the radar.
CRIER_MIN_RELEVANCE=50

# Video rendering.
CRIER_RENDER_RESOLUTION=720p
# Daily cap on renders that use AI video clips (stills renders are not capped).
CRIER_MAX_HERO_RENDERS_PER_DAY=6
CRIER_VIDEO_POLL_TIMEOUT_S=600
# Optional: absolute path to a .ttf font for captions and cards.
CRIER_FONT_PATH=
